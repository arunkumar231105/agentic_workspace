# Files kept out of the Docker build context (smaller, faster builds, no secrets in the image).

# Dependencies are installed inside the image by npm ci.
node_modules
tldraw-sync/node_modules

# Next.js build output, regenerated by the dev server.
.next

# Prisma client, regenerated by npm ci (postinstall).
lib/generated

# Git history isn't needed in the image.
.git

# Secrets: compose passes .env at runtime via env_file, so it never gets baked into the image.
.env*

# Firebase service account (secret)
firebase-service-account.json
